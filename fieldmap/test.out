 RELEASE= 2022 R2              BUILD= 22.2      UP20220516   VERSION=LINUX x64   
 CURRENT JOBNAME=file  09:49:33  JUL 24, 2026 CP=      0.289

     1  FINISH  
     2  /CLEAR, START   
     3  /PREP7  
     4      
     5  KEYW, PR_ELMAG, 1   
     6  KEYW, MAGELC, 1 
     7      
     8  ET, 1, SOLID123 
     9      
    10  ! Everything in mm (no unit in realty)  
    11  ingridThick = 0.010 ! Solid Ingrid without holes thickness  
    12  ingridSide = 14.0 ! Ingrid l and w (square) 
    13  cuAnodeClearance = 0.05 ! 50 um clearence between Ingrid and Anode  
    14  cuAnodeThick = 0.5 ! Cu Anode thickness 
    15  cuAnodeDrillSide = 13.0 ! Square drill bit  
    16  driftgap = 10.0 ! Cathode placement from Grid   
    17  tiCathodeThick  = 1.0 ! Ti Cathode thickness
    18  diaAnodeCathode = 28.0 ! Anode and Cathode diameter 
    19      
    20  ! Placement distances along z   
    21  h1 = 0.0
    22  h2 = ingridThick
    23  h3 = ingridThick + cuAnodeClearance 
    24  h4 = ingridThick + cuAnodeClearance + cuAnodeThick  
    25  h5 = ingridThick + cuAnodeClearance + cuAnodeThick + driftgap   
    26  h6 = ingridThick + cuAnodeClearance + cuAnodeThick + driftgap + tiCathodeThick  
    27      
    28  ! Make cylinder volume for Gas volume surrounding and including Ingrid plus clearence until Anode   
    29  WPOFFS, 0, 0, h1  ! Zero offset along z 
    30  CYL4, 0, 0, diaAnodeCathode/2, 0., , 360., h3 ! Vol 1 InGrid plus Anode Clearance   
    31  WPOFFS, 0, 0, -h1  ! Revert offset along z  
    32      
    33  ! Make volume block for ingrid (also drillbit for gas subtraction)  
    34  ! (x1,x2,y1,y2,z1,z2)   
    35  BLOCK, -ingridSide/2, ingridSide/2, -ingridSide/2, ingridSide/2, h1, h2 ! Vol 2 InGrid  
    36      
    37  ! Make cylinder volume for Copper Anode Base
    38  WPOFFS, 0, 0, h3  ! Offset along z  
    39  CYL4, 0, 0, diaAnodeCathode/2, 0., , 360., cuAnodeThick ! Vol 3 Copper Anode base   
    40  WPOFFS, 0, 0, -h3  ! Revert offset along z  
    41      
    42  ! Drill bit to subtract from Copper Anode Base (This is also gas gap)   
    43  ! (x1,x2,y1,y2,z1,z2)   
    44  BLOCK, -cuAnodeDrillSide/2, cuAnodeDrillSide/2, -cuAnodeDrillSide/2, cuAnodeDrillSide/2, h3, h4 ! Vol 4 Anode Drill bit (gas gap)   
    45      
    46  ! Make cylinder volume for Drift gap
    47  WPOFFS, 0, 0, h4  ! Offset along z  
    48  CYL4, 0, 0, diaAnodeCathode/2, 0., , 360., driftgap ! Vol 5 Drift Gap   
    49  WPOFFS, 0, 0, -h4  ! Revert offset along z  
    50      
    51  ! Make cylinder volume for Titanium Cathode 
    52  WPOFFS, 0, 0, h5  ! Offset along z  
    53  CYL4, 0, 0, diaAnodeCathode/2, 0., , 360., tiCathodeThick ! Vol 6 Titanium Cathode  
    54  WPOFFS, 0, 0, -h5  ! Revert offset along z  
    55      
    56  ! Subtract Ingrid Drill bit from base gas vol   
    57  VSBV, 1, 2, , ,KEEP !! Subtract from Vol 1, Vol 2. Free Vol 1 and keep Vol 2. Result saved to Vol 7.
    58      
    59  ! Subtract Drill bit from Copper Anode Base 
    60  VSBV, 3, 4, , ,KEEP !! Subtract from Vol 3, Vol 4. Free Vol 3 and keep Vol 4. Result (Anode) saved to Vol 1.
    61      
    62  ! ! ! Assign colors to all component volumes
    63  ! /COLOR, VOLU, BLUE, 2 ! InGrid
    64  ! /COLOR, VOLU, ORANGE, 7 ! Gas around Ingrid until Copper Anode
    65  ! /COLOR, VOLU, RED, 1 ! Copper Anode   
    66  ! /COLOR, VOLU, ORANGE, 4 ! Gas gap in Copper Anode 
    67  ! /COLOR, VOLU, ORANGE, 5 ! Drift gas gap   
    68  ! /COLOR, VOLU, BLUE, 6 ! Cathode   
    69      
    70  ! ! ! ! Geometry looks good, so glue them   
    71  VGLUE, ALL !! Gluing will change the volume numbers, check the new volumes assigned with VSEL   
    72  ! ! ! ! ! Out : 1 2 4 5 6 7 to 1 2 3 4 8 9  
    73      
    74  ! ! ! Run the following with each new vol ID to find out what Volume ID Ansys assigned: 
    75  ! VSEL, S,,, 8  
    76  ! VPLOT 
    77      
    78      
    79  /COLOR, VOLU, BLUE, 2 ! InGrid  
    80  /COLOR, VOLU, ORANGE, 9 ! Gas around Ingrid until Copper Anode  
    81  /COLOR, VOLU, RED, 1 ! Copper Anode 
    82  /COLOR, VOLU, ORANGE, 4 ! Gas gap in Copper Anode   
    83  /COLOR, VOLU, BLUE, 3 ! Cathode 
    84  /COLOR, VOLU, ORANGE, 8 ! Drift gas gap 
    85      
    86  ! ! For conductors use permitivity and resitivity, for insulators only permitivity  
    87  MP, PERX, 1, 1.0E5 ! 1. Aluminum
    88  MP, RSVX, 1, 0.0 ! 1. Aluminum resistivity  
    89  MP, PERX, 2, 1.0 ! 2. Gas Mixture (Drift / Holes)   
    90  MP, PERX, 3, 1.0E5 ! 3. Beryllium (Cathode) 
    91  MP, RSVX, 3, 0.0 ! 3. Beryllium resistivity 
    92      
    93  ! ! Assign material properties  
    94  VSEL, S,,, 2 ! Select vol 2 InGrid  
    95  VATT, 1,, 1 ! Assign to vol 2 material 1
    96  VSEL, S,,, 9 ! Select vol 9 Gas around Ingrid until Copper Anode
    97  VATT, 2,, 1 ! Assign to vol 9 material 2
    98  VSEL, S,,, 4 ! Select vol 4 Gas gap in Copper Anode 
    99  VATT, 2,, 1 ! Assign to vol 4 material 2
   100  VSEL, S,,, 8 ! Select vol 8 Drift gas gap   
   101  VATT, 2,, 1 ! Assign to vol 8 Drift gas gap 
   102  VSEL, S,,, 1 ! Select vol 1 Copper Anode
   103  VATT, 1,, 1 ! Assign to vol 1 material 1
   104  VSEL, S,,, 3 ! Select vol 3 Cathode 
   105  VATT, 1,, 1 ! Assign to vol 3 material 1
   106      
   107      
   108  ALLSEL  
   109  VPLOT   
   110      
   111  ! ! !--Boundary Conditions----  
   112  voltage_cathode = -1580 
   113  voltage_anode = -580
   114  voltage_chip = -430 
   115      
   116  ! ! Apply zero volt to the InGrid   
   117  VSEL, S,,, 2 ! Select the volume of InGrid  
   118  ASLV, S ! Select all alreas contained in the previously selected Volume 2   
   119  DA, ALL, VOLT, voltage_chip ! Apply voltage to the grid 
   120      
   121  ! ! Apply negative few hundres volts to the Copper Anode
   122  VSEL, S,,, 1 ! Select the volume of Copper Anode
   123  ASLV, S ! Select all alreas contained in the previously selected Volume 1   
   124  DA, ALL, VOLT, voltage_anode ! Apply voltage to the Copper Anode
   125      
   126  ! ! Voltage to the Beryllium window 
   127  VSEL, S,,, 3 ! Select the volume of Beryllium window
   128  ASLV, S ! Select all alreas contained in the previously selected Volume 3   
   129  DA, ALL, VOLT, voltage_cathode ! Apply voltage to the Beryllium window  
   130      
   131  ! !Meshing options  
   132  VSEL, S,,,1,9 ! Select all volumes from 1-9 
   133  ASLV, S ! Select all surface areas contained in the selected volume 
   134      
   135  MSHKEY, 0 ! Select free meshing 
   136  SMRT, 10 ! Meshing element size Fine = 1, Coarse = 10   
   137  VSEL, S,,,1 ! Select Vol 1! S = select new set (default)
   138  VSEL, A,,,2 ! Select Vol 2 ! A = additionally select and extend current 
   139  VSEL, A,,,3 ! Select Vol 3  
   140  VSEL, A,,,4 ! Select Vol 4  
   141  VSEL, A,,,8 ! Select Vol 9  
   142  VSEL, A,,,9 ! Select Vol 9  
   143  VMESH,ALL   
   144      
   145  ! Solve the field   
   146  /SOLU   
   147  SOLVE   
   148  FINISH  
   149      
   150  !Display the Solution for Electric Field
   151  !Comment this to run weighting potential
   152  /POST1  
   153  /EFACET, 1  
   154  PLNSOL, VOLT,, 0
   155      
